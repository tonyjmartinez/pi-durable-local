#!/usr/bin/env bash
# Start the pi-durable daemon under a restart loop, unless it is already running.
# Used instead of systemd on WSL, where WSLg hides the systemd user bus.
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
DATA="${PD_DATA_DIR:-$HOME/.local/share/pi-durable}"
PIDFILE="$DATA/pdd.pid"
LOG="$DATA/pdd.log"
NODE="$(command -v node || echo "$HOME/.nvm/versions/node/$(ls "$HOME/.nvm/versions/node" | tail -1)/bin/node")"
# Keep the daemon CLI's install directory available when started from a minimal shell.
export PATH="$HOME/.local/bin:$PATH"
umask 077
mkdir -p "$DATA"

# Supervisor loops are found by process (argv0 marker + this data dir's log path), not only the pidfile,
# because a second pdd-up used to overwrite the pidfile and orphan the first loop.
supervisors() { pgrep -f -- "pdd-up-supervisor .*${LOG}\$" || true; }

if [[ "${1:-}" == "stop" ]]; then
	found=0
	for pid in $(supervisors) $([[ -f "$PIDFILE" ]] && cat "$PIDFILE" || true); do
		# setsid made each loop a process-group leader: signal the group so its daemon goes too.
		if kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null; then found=1; fi
	done
	rm -f "$PIDFILE"
	[[ $found == 1 ]] && echo "pdd stopped" || echo "pdd was not running"
	exit 0
fi

running="$(supervisors | head -1)"
if [[ -n "$running" ]]; then
	echo "pdd already running (supervisor pid $running)"
	echo "$running" >"$PIDFILE"
	exit 0
fi

# setsid gives the loop its own process group, so `pdd-up stop` takes down the loop and the daemon together.
# The loop traps TERM so it exits at once, even while sleeping.
setsid bash -c '
	cd "$1"
	child=
	trap '"'"'[[ -n "$child" ]] && kill -TERM "$child" 2>/dev/null; exit 0'"'"' TERM INT
	while true; do
		"$2" --no-warnings src/daemon.ts >>"$3" 2>&1 &
		child=$!
		wait "$child" || true
		echo "$(date -Is) pdd exited; restarting in 5s" >>"$3"
		child=
		sleep 5 &
		wait $! || true
	done
' pdd-up-supervisor "$ROOT" "$NODE" "$LOG" </dev/null >/dev/null 2>&1 &
echo $! >"$PIDFILE"
echo "pdd started (pid $!, log $LOG)"
